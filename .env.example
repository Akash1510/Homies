# ==============================================================================
# Homies Clean - Environment Configuration Template
# Copy this file to .env.local (frontend) or backend/.env (backend) and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & Backend URL
# ------------------------------------------------------------------------------
# Local dev: http://127.0.0.1:8000
# Production: https://api.homiesclean.com (or your hosted FastAPI domain / Render / Fly.io)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway (Live or Test Credentials)
# Get your keys from: https://dashboard.razorpay.com/#/app/keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_HomiesDemoKey
RAZORPAY_KEY_ID=rzp_test_HomiesDemoKey
RAZORPAY_KEY_SECRET=rzp_secret_HomiesDemoSecret

# ------------------------------------------------------------------------------
# 3. Store Administration & WhatsApp Ordering
# ------------------------------------------------------------------------------
# Owner: Akash (akashgj777@gmail.com | +91 7776032964)
NEXT_PUBLIC_WHATSAPP_NUMBER=917776032964
NEXT_PUBLIC_ADMIN_EMAIL=akashgj777@gmail.com

# ------------------------------------------------------------------------------
# 4. FastAPI Backend & MongoDB Configuration (backend/.env)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. mongodb://localhost:27017 or Atlas cloud cluster)
MONGODB_URL=mongodb://localhost:27017
DB_NAME=homies
JWT_SECRET=super_secret_jwt_key_homies_clean_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
